          },
          "variables": {
            "$fxv#0": "<policies>\r\n  <inbound>\r\n    <base />\r\n    <return-response>\r\n      <set-status code=\"200\" reason=\"OK\" />\r\n      <set-header name=\"Content-Type\" exists-action=\"override\">\r\n        <value>application/json</value>\r\n      </set-header>\r\n      <set-body>@{\r\n        var gatewayUrl = context.Request.OriginalUrl.Scheme + \"://\" + context.Request.OriginalUrl.Host;\r\n        var tenantId = \"{{tenant-id}}\";\r\n        var clientId = \"{{apim-app-client-id}}\";\r\n        return Newtonsoft.Json.JsonConvert.SerializeObject(new {\r\n          resource = gatewayUrl + \"/ado/mcp\",\r\n          authorization_servers = new[] {\r\n            \"https://login.microsoftonline.com/\" + tenantId + \"/v2.0\"\r\n          },\r\n          scopes_supported = new[] {\r\n            \"api://\" + clientId + \"/user_impersonation\"\r\n          },\r\n          bearer_methods_supported = new[] { \"header\" },\r\n          resource_documentation = gatewayUrl + \"/well-known/oauth-protected-resource\",\r\n          resource_name = \"APIM MCP ADO Proxy\"\r\n        });\r\n      }</set-body>\r\n    </return-response>\r\n  </inbound>\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n  <on-error>\r\n    <base />\r\n  </on-error>\r\n</policies>\r\n",
            "$fxv#1": "<policies>\r\n  <inbound>\r\n    <base />\r\n    <!--\r\n      MCP Server OBO Policy — applied at the ado-mcp API scope.\r\n      1. Validate the incoming Azure AD Bearer token (audience = our APIM app).\r\n      2. Extract the user token.\r\n      3. Acquire an MI assertion token (federated credential toward Entra).\r\n      4. Exchange user token for an ADO token via OBO (jwt-bearer grant).\r\n      5. On consent_required / interaction_required → return 403 with consent_uri.\r\n      6. On success → set Authorization header with the ADO OBO token.\r\n    -->\r\n\r\n    <!-- Step 1: Validate the incoming user Bearer token -->\r\n    <validate-azure-ad-token tenant-id=\"{{tenant-id}}\"\r\n                              failed-validation-httpcode=\"401\"\r\n                              failed-validation-error-message=\"Access token is missing or invalid.\">\r\n      <audiences>\r\n        <audience>{{apim-app-client-id}}</audience>\r\n        <audience>api://{{apim-app-client-id}}</audience>\r\n      </audiences>\r\n    </validate-azure-ad-token>\r\n\r\n    <!-- Step 2: Stash the original user Bearer token before it might be replaced -->\r\n    <set-variable name=\"UserToken\"\r\n                  value=\"@(context.Request.Headers.GetValueOrDefault(\"Authorization\",\"\").Replace(\"Bearer \",\"\"))\" />\r\n\r\n    <!-- Step 3: Acquire MI assertion token for client_assertion (federated credential) -->\r\n    <authentication-managed-identity resource=\"api://AzureADTokenExchange\"\r\n                                      client-id=\"{{managed-identity-client-id}}\"\r\n                                      output-token-variable-name=\"MiAssertionToken\"\r\n                                      ignore-error=\"false\" />\r\n\r\n    <!-- Step 4: OBO exchange — POST to Entra token endpoint -->\r\n    <send-request mode=\"new\"\r\n                  response-variable-name=\"OboResponse\"\r\n                  timeout=\"30\"\r\n                  ignore-error=\"false\">\r\n      <set-url>https://login.microsoftonline.com/{{tenant-id}}/oauth2/v2.0/token</set-url>\r\n      <set-method>POST</set-method>\r\n      <set-header name=\"Content-Type\" exists-action=\"override\">\r\n        <value>application/x-www-form-urlencoded</value>\r\n      </set-header>\r\n      <set-body>@{\r\n        var userToken       = (string)context.Variables[\"UserToken\"];\r\n        var miToken         = (string)context.Variables[\"MiAssertionToken\"];\r\n        var clientId        = \"{{apim-app-client-id}}\";\r\n        var adoScope        = \"{{ado-scope}} offline_access\";\r\n        return\r\n          \"grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer\"\r\n          + \"&client_id=\"            + Uri.EscapeDataString(clientId)\r\n          + \"&client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer\"\r\n          + \"&client_assertion=\"     + Uri.EscapeDataString(miToken)\r\n          + \"&assertion=\"            + Uri.EscapeDataString(userToken)\r\n          + \"&scope=\"                + Uri.EscapeDataString(adoScope)\r\n          + \"&requested_token_use=on_behalf_of\";\r\n      }</set-body>\r\n    </send-request>\r\n\r\n    <!-- Step 5: Parse OBO response and check for consent errors -->\r\n    <choose>\r\n      <when condition=\"@{\r\n        var status = ((IResponse)context.Variables[\"OboResponse\"]).StatusCode;\r\n        if (status != 200) {\r\n          var body = ((IResponse)context.Variables[\"OboResponse\"]).Body.As<string>(preserveContent: true);\r\n          return body.Contains(\"interaction_required\")\r\n              || body.Contains(\"consent_required\")\r\n              || body.Contains(\"invalid_grant\");\r\n        }\r\n        return false;\r\n      }\">\r\n        <!-- Consent required — return 403 with a usable consent_uri -->\r\n        <return-response>\r\n          <set-status code=\"403\" reason=\"Consent Required\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>application/json</value>\r\n          </set-header>\r\n          <set-body>@{\r\n            var gatewayUrl = context.Request.OriginalUrl.Scheme + \"://\" + context.Request.OriginalUrl.Host;\r\n            return Newtonsoft.Json.JsonConvert.SerializeObject(new {\r\n              error       = \"consent_required\",\r\n              description = \"Admin consent is required to access Azure DevOps. An admin must visit consent_uri to grant access for the organization.\",\r\n              consent_uri = gatewayUrl + \"/authorize\"\r\n            });\r\n          }</set-body>\r\n        </return-response>\r\n      </when>\r\n      <when condition=\"@(((IResponse)context.Variables[\"OboResponse\"]).StatusCode != 200)\">\r\n        <!-- Any other OBO failure — return 502 with the error details -->\r\n        <return-response>\r\n          <set-status code=\"502\" reason=\"OBO Token Exchange Failed\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>application/json</value>\r\n          </set-header>\r\n          <set-body>@{\r\n            var body = ((IResponse)context.Variables[\"OboResponse\"]).Body.As<string>(preserveContent: true);\r\n            return Newtonsoft.Json.JsonConvert.SerializeObject(new {\r\n              error       = \"obo_exchange_failed\",\r\n              description = \"The OBO token exchange failed.\",\r\n              details     = body\r\n            });\r\n          }</set-body>\r\n        </return-response>\r\n      </when>\r\n    </choose>\r\n\r\n    <!-- Step 6: OBO succeeded — extract the access_token and set Authorization header -->\r\n    <set-variable name=\"AdoAccessToken\"\r\n                  value=\"@(((IResponse)context.Variables[\"OboResponse\"]).Body.As<JObject>()[\"access_token\"].ToString())\" />\r\n\r\n    <set-header name=\"Authorization\" exists-action=\"override\">\r\n      <value>@(\"Bearer \" + (string)context.Variables[\"AdoAccessToken\"])</value>\r\n    </set-header>\r\n  </inbound>\r\n\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n\r\n  <on-error>\r\n    <base />\r\n    <!-- On 401 errors, add WWW-Authenticate pointing to our PRM endpoint -->\r\n    <choose>\r\n      <when condition=\"@(context.Response.StatusCode == 401)\">\r\n        <set-header name=\"WWW-Authenticate\" exists-action=\"override\">\r\n          <value>@{\r\n            var gatewayUrl = context.Request.OriginalUrl.Scheme + \"://\" + context.Request.OriginalUrl.Host;\r\n            return \"Bearer resource_metadata=\\\"\" + gatewayUrl + \"/well-known/oauth-protected-resource\\\"\";\r\n          }</value>\r\n        </set-header>\r\n      </when>\r\n    </choose>\r\n  </on-error>\r\n</policies>\r\n",
            "$fxv#2": "<policies>\r\n  <inbound>\r\n    <base />\r\n    <!--\r\n      Admin consent initiation — GET /authorize\r\n      Redirects to the Entra *admin consent* endpoint so a tenant admin can grant\r\n      the Azure DevOps user_impersonation delegated permission for all users.\r\n      After approval Entra redirects to /callback?admin_consent=True&tenant=...\r\n    -->\r\n    <return-response>\r\n      <set-status code=\"302\" reason=\"Found\" />\r\n      <set-header name=\"Location\" exists-action=\"override\">\r\n        <value>@{\r\n          var tenantId    = \"{{tenant-id}}\";\r\n          var clientId    = \"{{apim-app-client-id}}\";\r\n          var gatewayUrl  = context.Request.OriginalUrl.Scheme + \"://\" + context.Request.OriginalUrl.Host;\r\n          var redirectUri = Uri.EscapeDataString(gatewayUrl + \"/callback\");\r\n          var state       = System.Guid.NewGuid().ToString(\"N\");\r\n          return\r\n            \"https://login.microsoftonline.com/\" + tenantId + \"/v2.0/adminconsent\"\r\n            + \"?client_id=\"     + clientId\r\n            + \"&redirect_uri=\"  + redirectUri\r\n            + \"&scope=\"         + Uri.EscapeDataString(\"https://management.azure.com/.default\")\r\n            + \"&state=\"         + state;\r\n        }</value>\r\n      </set-header>\r\n    </return-response>\r\n  </inbound>\r\n\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n\r\n  <on-error>\r\n    <base />\r\n  </on-error>\r\n</policies>\r\n",
            "$fxv#3": "<policies>\r\n  <inbound>\r\n    <base />\r\n    <!--\r\n      Consent callback — GET /callback\r\n      Handles TWO scenarios:\r\n        A) Admin consent: ?admin_consent=True&tenant=...  (no code)\r\n        B) Auth code:     ?code=...                       (legacy / user consent)\r\n      For admin consent, just return the success page — no token exchange needed.\r\n      For auth code, exchange the code for tokens using the MI as client_assertion.\r\n    -->\r\n\r\n    <choose>\r\n      <!-- Scenario A: admin consent callback -->\r\n      <when condition=\"@(context.Request.Url.Query.GetValueOrDefault(\"admin_consent\",\"\").ToLower() == \"true\")\">\r\n        <return-response>\r\n          <set-status code=\"200\" reason=\"OK\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>text/html; charset=utf-8</value>\r\n          </set-header>\r\n          <set-body><![CDATA[<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head><meta charset=\"utf-8\"><title>Admin Consent Granted</title>\r\n<style>body{font-family:sans-serif;max-width:560px;margin:80px auto;text-align:center}\r\nh1{color:#107c10}p{color:#444}code{background:#f3f3f3;padding:2px 6px;border-radius:3px}</style></head>\r\n<body>\r\n  <h1>&#10003; Admin consent granted successfully</h1>\r\n  <p>All users in the organization can now use the APIM MCP ADO Proxy.</p>\r\n  <p>You can close this window and retry your MCP request in VS Code.</p>\r\n</body>\r\n</html>]]></set-body>\r\n        </return-response>\r\n      </when>\r\n    </choose>\r\n\r\n    <!-- Scenario B: auth code exchange (user consent flow) -->\r\n    <set-variable name=\"AuthCode\"\r\n                  value=\"@(context.Request.Url.Query.GetValueOrDefault(\"code\", \"\"))\" />\r\n\r\n    <choose>\r\n      <when condition=\"@(string.IsNullOrEmpty((string)context.Variables[\"AuthCode\"]))\">\r\n        <return-response>\r\n          <set-status code=\"400\" reason=\"Bad Request\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>application/json</value>\r\n          </set-header>\r\n          <set-body>{\"error\":\"missing_code\",\"description\":\"No authorization code or admin_consent flag found in the callback request.\"}</set-body>\r\n        </return-response>\r\n      </when>\r\n    </choose>\r\n\r\n    <authentication-managed-identity resource=\"api://AzureADTokenExchange\"\r\n                                      client-id=\"{{managed-identity-client-id}}\"\r\n                                      output-token-variable-name=\"MiAssertionToken\"\r\n                                      ignore-error=\"false\" />\r\n\r\n    <send-request mode=\"new\"\r\n                  response-variable-name=\"TokenResponse\"\r\n                  timeout=\"30\"\r\n                  ignore-error=\"false\">\r\n      <set-url>https://login.microsoftonline.com/{{tenant-id}}/oauth2/v2.0/token</set-url>\r\n      <set-method>POST</set-method>\r\n      <set-header name=\"Content-Type\" exists-action=\"override\">\r\n        <value>application/x-www-form-urlencoded</value>\r\n      </set-header>\r\n      <set-body>@{\r\n        var code        = (string)context.Variables[\"AuthCode\"];\r\n        var miToken     = (string)context.Variables[\"MiAssertionToken\"];\r\n        var clientId    = \"{{apim-app-client-id}}\";\r\n        var gatewayUrl  = context.Request.OriginalUrl.Scheme + \"://\" + context.Request.OriginalUrl.Host;\r\n        var redirectUri = Uri.EscapeDataString(gatewayUrl + \"/callback\");\r\n        return\r\n          \"grant_type=authorization_code\"\r\n          + \"&client_id=\"            + Uri.EscapeDataString(clientId)\r\n          + \"&client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer\"\r\n          + \"&client_assertion=\"     + Uri.EscapeDataString(miToken)\r\n          + \"&code=\"                 + Uri.EscapeDataString(code)\r\n          + \"&redirect_uri=\"         + redirectUri;\r\n      }</set-body>\r\n    </send-request>\r\n\r\n    <choose>\r\n      <when condition=\"@(((IResponse)context.Variables[\"TokenResponse\"]).StatusCode == 200)\">\r\n        <return-response>\r\n          <set-status code=\"200\" reason=\"OK\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>text/html; charset=utf-8</value>\r\n          </set-header>\r\n          <set-body><![CDATA[<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head><meta charset=\"utf-8\"><title>Consent Granted</title>\r\n<style>body{font-family:sans-serif;max-width:520px;margin:80px auto;text-align:center}\r\nh1{color:#107c10}p{color:#444}</style></head>\r\n<body>\r\n  <h1>&#10003; Consent granted successfully</h1>\r\n  <p>You can close this window and retry your MCP request in VS Code.</p>\r\n</body>\r\n</html>]]></set-body>\r\n        </return-response>\r\n      </when>\r\n      <otherwise>\r\n        <return-response>\r\n          <set-status code=\"400\" reason=\"Token Exchange Failed\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>application/json</value>\r\n          </set-header>\r\n          <set-body>@{\r\n            var body = ((IResponse)context.Variables[\"TokenResponse\"]).Body.As<string>(preserveContent: true);\r\n            return Newtonsoft.Json.JsonConvert.SerializeObject(new {\r\n              error       = \"token_exchange_failed\",\r\n              description = \"The authorization code exchange failed.\",\r\n              details     = body\r\n            });\r\n          }</set-body>\r\n        </return-response>\r\n      </otherwise>\r\n    </choose>\r\n  </inbound>\r\n\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n\r\n  <on-error>\r\n    <base />\r\n  </on-error>\r\n</policies>\r\n\r\n    <!-- Step 1: Extract the authorization code from the query string -->\r\n    <set-variable name=\"AuthCode\"\r\n                  value=\"@(context.Request.Url.Query.GetValueOrDefault(\"code\", \"\"))\" />\r\n\r\n    <!-- Step 2: Check the code is present -->\r\n    <choose>\r\n      <when condition=\"@(string.IsNullOrEmpty((string)context.Variables[\"AuthCode\"]))\">\r\n        <return-response>\r\n          <set-status code=\"400\" reason=\"Bad Request\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>application/json</value>\r\n          </set-header>\r\n          <set-body>{\"error\":\"missing_code\",\"description\":\"No authorization code found in the callback request.\"}</set-body>\r\n        </return-response>\r\n      </when>\r\n    </choose>\r\n\r\n    <!-- Step 3: Acquire MI assertion token for use as client_assertion -->\r\n    <authentication-managed-identity resource=\"api://AzureADTokenExchange\"\r\n                                      client-id=\"{{managed-identity-client-id}}\"\r\n                                      output-token-variable-name=\"MiAssertionToken\"\r\n                                      ignore-error=\"false\" />\r\n\r\n    <!-- Step 4: Exchange the authorization code for tokens -->\r\n    <send-request mode=\"new\"\r\n                  response-variable-name=\"TokenResponse\"\r\n                  timeout=\"30\"\r\n                  ignore-error=\"false\">\r\n      <set-url>https://login.microsoftonline.com/{{tenant-id}}/oauth2/v2.0/token</set-url>\r\n      <set-method>POST</set-method>\r\n      <set-header name=\"Content-Type\" exists-action=\"override\">\r\n        <value>application/x-www-form-urlencoded</value>\r\n      </set-header>\r\n      <set-body>@{\r\n        var code        = (string)context.Variables[\"AuthCode\"];\r\n        var miToken     = (string)context.Variables[\"MiAssertionToken\"];\r\n        var clientId    = \"{{apim-app-client-id}}\";\r\n        var gatewayUrl  = context.Request.OriginalUrl.Scheme + \"://\" + context.Request.OriginalUrl.Host;\r\n        var redirectUri = Uri.EscapeDataString(gatewayUrl + \"/callback\");\r\n        return\r\n          \"grant_type=authorization_code\"\r\n          + \"&client_id=\"            + Uri.EscapeDataString(clientId)\r\n          + \"&client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer\"\r\n          + \"&client_assertion=\"     + Uri.EscapeDataString(miToken)\r\n          + \"&code=\"                 + Uri.EscapeDataString(code)\r\n          + \"&redirect_uri=\"         + redirectUri;\r\n      }</set-body>\r\n    </send-request>\r\n\r\n    <!-- Step 5: Return result -->\r\n    <choose>\r\n      <when condition=\"@(((IResponse)context.Variables[\"TokenResponse\"]).StatusCode == 200)\">\r\n        <return-response>\r\n          <set-status code=\"200\" reason=\"OK\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>text/html; charset=utf-8</value>\r\n          </set-header>\r\n          <set-body><![CDATA[<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head><meta charset=\"utf-8\"><title>Consent Granted</title>\r\n<style>body{font-family:sans-serif;max-width:520px;margin:80px auto;text-align:center}\r\nh1{color:#107c10}p{color:#444}</style></head>\r\n<body>\r\n  <h1>&#10003; Consent granted successfully</h1>\r\n  <p>You can close this window and retry your MCP request in VS Code.</p>\r\n</body>\r\n</html>]]></set-body>\r\n        </return-response>\r\n      </when>\r\n      <otherwise>\r\n        <return-response>\r\n          <set-status code=\"400\" reason=\"Token Exchange Failed\" />\r\n          <set-header name=\"Content-Type\" exists-action=\"override\">\r\n            <value>application/json</value>\r\n          </set-header>\r\n          <set-body>@{\r\n            var body = ((IResponse)context.Variables[\"TokenResponse\"]).Body.As<string>(preserveContent: true);\r\n            return Newtonsoft.Json.JsonConvert.SerializeObject(new {\r\n              error       = \"token_exchange_failed\",\r\n              description = \"The authorization code exchange failed.\",\r\n              details     = body\r\n            });\r\n          }</set-body>\r\n        </return-response>\r\n      </otherwise>\r\n    </choose>\r\n  </inbound>\r\n\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n\r\n  <on-error>\r\n    <base />\r\n  </on-error>\r\n</policies>\r\n"
