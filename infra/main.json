.WebUtility.UrlEncode((string)context.Variables[\"UserToken\"])\r\n          + \"&scope=\" + System.Net.WebUtility.UrlEncode(\"{{ado-scope}} openid profile\")\r\n          + \"&requested_token_use=on_behalf_of\";\r\n      }</set-body>\r\n    </send-request>\r\n    <!-- Step 5: Check OBO result — detect consent_required / interaction_required -->\r\n    <choose>\r\n      <when condition=\"@(((IResponse)context.Variables[\"OboResponse\"]).StatusCode != 200)\">\r\n        <set-variable name=\"OboError\" value=\"@{\r\n          var body = ((IResponse)context.Variables[\"OboResponse\"]).Body.As<string>(preserveContent: true);\r\n          try {\r\n            var json = Newtonsoft.Json.Linq.JObject.Parse(body);\r\n            return json[\"error\"]?.ToString() ?? \"unknown_error\";\r\n          } catch { return \"unknown_error\"; }\r\n        }\" />\r\n        <choose>\r\n          <when condition=\"@{\r\n            var err = (string)context.Variables[\"OboError\"];\r\n            return err == \"interaction_required\" || err == \"invalid_grant\" || err == \"consent_required\";\r\n          }\">\r\n            <return-response>\r\n              <set-status code=\"403\" reason=\"Forbidden\" />\r\n              <set-header name=\"Content-Type\" exists-action=\"override\">\r\n                <value>application/json</value>\r\n              </set-header>\r\n              <set-body>@{\r\n                var gatewayUrl = context.Request.OriginalUrl.Scheme + \"://\" + context.Request.OriginalUrl.Host;\r\n                return Newtonsoft.Json.JsonConvert.SerializeObject(new {\r\n                  error = \"consent_required\",\r\n                  error_description = \"User consent is required for Azure DevOps access. Visit the consent_uri to grant access.\",\r\n                  consent_uri = gatewayUrl + \"/authorize\"\r\n                });\r\n              }</set-body>\r\n            </return-response>\r\n          </when>\r\n          <otherwise>\r\n            <return-response>\r\n              <set-status code=\"502\" reason=\"Bad Gateway\" />\r\n              <set-header name=\"Content-Type\" exists-action=\"override\">\r\n                <value>application/json</value>\r\n              </set-header>\r\n              <set-body>@{\r\n                var body = ((IResponse)context.Variables[\"OboResponse\"]).Body.As<string>(preserveContent: true);\r\n                return Newtonsoft.Json.JsonConvert.SerializeObject(new {\r\n                  error = \"token_exchange_failed\",\r\n                  error_description = body\r\n                });\r\n              }</set-body>\r\n            </return-response>\r\n          </otherwise>\r\n        </choose>\r\n      </when>\r\n    </choose>\r\n    <!-- Step 6: Extract the ADO access token and replace Authorization header -->\r\n    <set-variable name=\"AdoToken\" value=\"@{\r\n      var body = ((IResponse)context.Variables[\"OboResponse\"]).Body.As<string>(preserveContent: true);\r\n      var json = Newtonsoft.Json.Linq.JObject.Parse(body);\r\n      return json[\"access_token\"]?.ToString() ?? string.Empty;\r\n    }\" />\r\n    <set-header name=\"Authorization\" exists-action=\"override\">\r\n      <value>@(\"Bearer \" + (string)context.Variables[\"AdoToken\"])</value>\r\n    </set-header>\r\n    <!-- Step 7: Strip subscription key header if present -->\r\n    <set-header name=\"Ocp-Apim-Subscription-Key\" exists-action=\"delete\" />\r\n  </inbound>\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n  <outbound>\r\n    <base />\r\n    <!-- Expose WWW-Authenticate on 401 from backend for good measure -->\r\n  </outbound>\r\n  <on-error>\r\n    <base />\r\n    <!-- On validation failure (401), add WWW-Authenticate so clients can discover the PRM URL -->\r\n    <choose>\r\n      <when condition=\"@(context.Response.StatusCode == 401)\">\r\n        <set-header name=\"WWW-Authenticate\" exists-action=\"override\">\r\n          <value>@{\r\n            var gatewayUrl = context.Request.Original